---
import { title } from "@utils/title"
---

<footer class="bg-slate-900 text-white py-20 mt-32 relative overflow-hidden border-t border-white/5">
    <!-- Decorative background - Dark theme style -->
    <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/4 w-96 h-96 bg-brand-primary/5 rounded-full blur-[120px] pointer-events-none opacity-40"></div>
    <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/4 w-64 h-64 bg-brand-secondary/5 rounded-full blur-[100px] pointer-events-none opacity-20"></div>

    <div class="container mx-auto px-6 max-w-6xl relative z-10">
        <div class="flex flex-col md:flex-row justify-between items-center gap-16">
            <div class="flex flex-col items-center md:items-start gap-6">
               <div class="flex items-center gap-4 group cursor-default">
                  <div class="relative">
                    <div class="absolute inset-0 bg-brand-primary/30 rounded-full blur-xl scale-90 group-hover:scale-110 transition-all opacity-0 group-hover:opacity-100"></div>
                    <img src="/logo.png" class="w-14 h-14 rounded-full border-2 border-white/10 group-hover:border-brand-primary/50 transition-colors bg-slate-900 relative z-10" alt="Logo" />
                  </div>
                  <h3 class="text-2xl font-bold font-display tracking-tight mb-0">{title}</h3>
               </div>
               <p class="text-slate-400 text-base max-w-xs text-center md:text-left leading-relaxed font-medium">
                  Comprometidos con la difusión científica y el empoderamiento de los estudiantes de medicina.
               </p>
            </div>

            <div class="flex flex-col items-center md:items-end gap-8 text-center md:text-right">
                <div class="flex gap-5">
                    <a href="#" class="w-12 h-12 glass !bg-white/5 flex items-center justify-center rounded-full hover:!bg-brand-primary/20 transition-all hover:scale-110 border-white/10 group">
                        <i class="fab fa-facebook-f text-lg text-slate-300 group-hover:text-white"></i>
                    </a>
                    <a href="#" class="w-12 h-12 glass !bg-white/5 flex items-center justify-center rounded-full hover:!bg-brand-primary/20 transition-all hover:scale-110 border-white/10 group">
                        <i class="fab fa-instagram text-lg text-slate-300 group-hover:text-white"></i>
                    </a>
                    <a href="#" class="w-12 h-12 glass !bg-white/5 flex items-center justify-center rounded-full hover:!bg-brand-primary/20 transition-all hover:scale-110 border-white/10 group">
                        <i class="fab fa-linkedin-in text-lg text-slate-300 group-hover:text-white"></i>
                    </a>
                    <a href="#" class="w-12 h-12 glass !bg-white/5 flex items-center justify-center rounded-full hover:!bg-brand-primary/20 transition-all hover:scale-110 border-white/10 group">
                        <i class="fab fa-whatsapp text-lg text-slate-300 group-hover:text-white"></i>
                    </a>
                </div>
                
                <div class="pt-10 border-t border-white/5 w-full md:w-auto min-w-[300px] flex flex-col md:flex-row md:justify-end gap-3 text-slate-500 text-[11px] font-bold uppercase tracking-widest">
                    <span>© {new Date().getFullYear()} {title}</span>
                    <span class="hidden md:inline mx-1 opacity-20">•</span>
                    <span>Excelencia en Investigación</span>
                </div>
            </div>
        </div>
    </div>
</footer>
---
import { cursos } from "../../utils/cursos";
---

<div class="flex justify-center items-center m-5">
  <div class="flex flex-col items-start max-w-[1024px]">
    <h3
      class="!my-3.5 bg-[#006A07] px-4 py-2 text-white !font-bold rounded-full !text-2xl"
    >
      Últimos Cursos
    </h3>
    {
      cursos.map((c) => {
        return (
          <div class="my-3 flex items-center gap-3">
            <img class="w-52 rounded" src={c.img} alt="Curso" />
            <div>
              <h4>{c.title}</h4>
              <p>{c.desc}</p>
            </div>
          </div>
        );
      })
    }
  </div>
</div>

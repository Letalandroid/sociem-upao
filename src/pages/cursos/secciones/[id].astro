---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";

export const getStaticPaths = (async () => {
  const sessions = await getCollection("sessions");

  return sessions.map((s) => ({
    params: { id: s.id.replace(".md", "").replace(/^.*\//, "") },
    props: { s },
  }));
}) satisfies GetStaticPaths;

const { s } = Astro.props;
const { data, slug } = s;
const { id, img, course, video } = data;
---

<Layout>
  <div class="flex justify-center items-center w-full h-screen">
    <div class="flex mx-2 flex-col xl:flex-row gap-3 justify-center items-center xl:items-start">
        <img transition:name={`session-${id}`} class="w-full h-96 xl:h-full object-cover xl:w-1/3" src={`${img}/s${id}.jpg`} alt={`flayer-session-${id}`} />
        <div class="flex flex-col items-center gap-2">
          <h2 class="w-96 text-center sm:text-left">{course}</h2>
          <iframe src={video} title={course} allowfullscreen class="w-full sm:w-[480px] h-[240px] xl:w-[720px] xl:h-[380px] mb-3 lg:mb-0"></iframe>
        </div>
      </div>
  </div>
</Layout>

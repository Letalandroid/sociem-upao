---
import "@styles/components/Cursos.module.css";
import { getCollection, render } from "astro:content";
import VerCursos from "./VerCursos.astro";

const courses = await getCollection("courses");
---

<div class="flex justify-center items-center m-5">
  <div class="flex flex-col items-center sm:items-start max-w-4/5 sm:max-w-5xl">
    <h3
      class="!my-4 bg-[#006A07] px-4 py-2 text-white !font-bold rounded-full !text-2xl"
    >
      Últimos Cursos
    </h3>
    {
      courses.map(async (c) => {
        const { Content } = await render(c);
        const { data, slug } = c;
        const { title, img, sessionTitles } = data;

        return (
          <a
            data-aos="zoom-in"
            data-aos-duration="850"
            href={`/cursos/${slug}`}
            class="!no-underline not-last:my-3 flex flex-col sm:flex-row items-center gap-3"
          >
            <img
              transition:name={`img-${slug}`}
              class="w-full sm:w-64 h-[256px] sm:h-64 object-cover rounded"
              src={img}
              alt={`Curso ${slug.replace("-", " ")}`}
            />
            <div class="text-black">
              <h4 class="!font-bold text-center sm:!text-start underline">
                {title}
              </h4>
              <div class="hidden sm:block">
                {sessionTitles.map((t) => {
                  return <p class="mb-0">- {t}</p>;
                })}
              </div>
              <Content />
            </div>
          </a>
        );
      })
    }
    <VerCursos />
  </div>
</div>

---
import { cursos } from "../../utils/cursos";
---

<div class="flex justify-center items-center m-2 sm:m-5">
  <div class="flex flex-col items-start max-w-sm sm:max-w-5xl">
    <h3
      class="!my-3.5 bg-[#006A07] px-4 py-2 text-white !font-bold rounded-full !text-2xl"
    >
      Últimos Cursos
    </h3>
    {
      cursos.map((c) => {
        return (
          <div class="my-3 flex flex-col sm:flex-row items-center gap-3">
            <img class="w-full sm:w-52 rounded" src={c.img} alt="Curso" />
            <div>
              <h4 class="!font-bold underline">{c.title}</h4>
              <p>{c.desc}</p>
            </div>
          </div>
        );
      })
    }
  </div>
</div>

---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";

export const getStaticPaths = (async () => {
  const sessions = await getCollection("sessions");

  return sessions.map((s) => ({
    params: { id: s.id.replace(".md", "").replace(/^.*\//, "") },
    props: { s },
  }));
}) satisfies GetStaticPaths;

const { s } = Astro.props;
const { data } = s;
const { id, img, course, video } = data;
---

<Layout>
  <section class="min-h-screen bg-slate-950 flex items-center justify-center py-24 relative overflow-hidden">
    <!-- Immersive Background Glows -->
    <div class="absolute top-0 right-0 w-[50%] h-full bg-brand-primary/5 blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[40%] h-full bg-brand-secondary/5 blur-[100px] pointer-events-none"></div>
    
    <div class="container mx-auto px-6 max-w-7xl relative z-10">
      <!-- Session Header -->
      <div class="flex flex-col md:flex-row justify-between items-center mb-12 gap-6" data-aos="fade-down">
         <div class="flex items-center gap-4">
             <div class="w-12 h-12 rounded-2xl bg-brand-primary/20 flex items-center justify-center text-brand-primary border border-brand-primary/30">
                <i class="fas fa-play-circle text-2xl"></i>
             </div>
             <div>
                <span class="text-brand-primary font-bold text-xs uppercase tracking-widest block mb-1">Módulo de Aprendizaje</span>
                <h1 class="text-3xl md:text-5xl font-extrabold text-white font-display tracking-tight leading-none mb-0">{course}</h1>
             </div>
         </div>
         <a href="/cursos" class="group flex items-center gap-3 text-slate-400 font-bold hover:text-white transition-colors">
            <i class="fas fa-chevron-left text-xs group-hover:-translate-x-1 transition-transform"></i>
            Volver
         </a>
      </div>

      <!-- Video Player Card - Dark Premium -->
      <div class="glass rounded-[2rem] overflow-hidden border border-white/10 shadow-2xl flex flex-col xl:flex-row gap-0 group" data-aos="zoom-in">
          <!-- Thumbnail/Info Column -->
          <div class="w-full xl:w-[400px] bg-slate-900/50 p-8 flex flex-col relative overflow-hidden shrink-0">
             <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-primary/20 to-transparent"></div>
             
             <div class="relative group/img overflow-hidden rounded-2xl border border-white/5 shadow-2xl mb-8">
                <img 
                  transition:name={`session-${id}`} 
                  class="w-full object-cover aspect-video xl:aspect-square group-hover/img:scale-110 transition-transform duration-700 opacity-90" 
                  src={`${img}/s${id}.jpg`} 
                  alt={`flayer-session-${id}`} 
                />
                <div class="absolute inset-0 bg-brand-primary/10 opacity-0 group-hover/img:opacity-100 transition-opacity"></div>
             </div>
             
             <div class="space-y-6">
                <div class="space-y-2">
                   <h3 class="text-white font-bold text-xl font-display">Recursos Disponibles</h3>
                   <div class="h-1 w-12 bg-brand-primary rounded-full"></div>
                </div>
                
                <div class="grid grid-cols-1 gap-3">
                   <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-800/40 border border-white/5 hover:border-brand-primary/30 transition-all cursor-default">
                      <i class="fas fa-file-pdf text-brand-primary text-xl"></i>
                      <span class="text-slate-300 font-medium">Material de Lectura</span>
                   </div>
                   <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-800/40 border border-white/5 hover:border-brand-primary/30 transition-all cursor-default">
                      <i class="fas fa-tasks text-brand-primary text-xl"></i>
                      <span class="text-slate-300 font-medium">Evaluación del Módulo</span>
                   </div>
                </div>
                
                <div class="pt-8 mt-auto">
                    <p class="text-slate-500 text-sm italic font-medium leading-relaxed">
                       SOCIEM UPAO · Excelencia Científica y Académica 🔬
                    </p>
                </div>
             </div>
          </div>
          
          <!-- Large Video Column -->
          <div class="flex-grow bg-black relative aspect-video">
              <iframe 
                src={video} 
                title={course} 
                allowfullscreen 
                class="absolute inset-0 w-full h-full border-0"
              ></iframe>
              <!-- Subtle overlay glow to video corners -->
              <div class="absolute inset-x-0 top-0 h-2 px-10 bg-gradient-to-b from-brand-primary/20 to-transparent pointer-events-none opacity-50"></div>
          </div>
      </div>
      
      <!-- Footer Note -->
      <div class="mt-12 text-center" data-aos="fade-up">
          <p class="text-slate-500 text-sm font-bold uppercase tracking-[0.3em]">Sesión {id} · Unidad de Aprendizaje</p>
      </div>
    </div>
  </section>
</Layout>

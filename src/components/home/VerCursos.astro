---
---
<a class="!no-underline group inline-block" href="/cursos">
  <button
    class="flex gap-4 items-center text-white rounded-full px-10 py-4 bg-brand-primary font-bold text-lg transition-all duration-500 hover:scale-[1.03] hover:bg-brand-accent shadow-2xl relative overflow-hidden active:scale-95 border border-white/10 group-hover:border-brand-secondary/30"
  >
    <!-- Background shimmer/glow effect - Dark mode optimized -->
    <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-[200%] group-hover:translate-x-[200%] transition-transform duration-1000 ease-in-out"></span>
    
    <span class="relative z-10 flex items-center gap-3">
      Ver Todos los Cursos
      <i class="fas fa-arrow-right text-sm transition-transform duration-500 group-hover:translate-x-2 group-hover:rotate-[-45deg]"></i>
    </span>
    
    <!-- Accent orbit glow -->
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[300%] bg-brand-secondary/10 blur-2xl origin-center animate-[spin_4s_linear_infinite] opacity-0 group-hover:opacity-100 transition-opacity duration-1000"></span>
  </button>
</a>

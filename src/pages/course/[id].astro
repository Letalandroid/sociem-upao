---
import "@styles/courses/index.css";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { render } from "astro:content";

export const getStaticPaths = (async () => {
  const courses = await getCollection("courses");

  return courses.map((c) => ({
    params: { id: c.slug },
    props: { c },
  }));
}) satisfies GetStaticPaths;

const { c } = Astro.props;
const { data, slug } = c;
const { title, img } = data;
const { Content } = await render(c);
---

<Layout>
  <div
    class={`bg-[url(${img})] bg-center bg-no-repeat bg-cover blur-xs flex justify-center items-center w-full h-56`}
  >
  </div>
  <div
    class='relative -top-56 flex justify-center items-center w-full h-56'
  >
    <div
      class="relative top-56 lg:top-28 flex flex-col lg:flex-row justify-center max-w-[80%] lg:max-w-1/2"
    >
      <div
        class="relative lg:absolute w-full flex flex-col lg:flex-row items-center gap-4 lg:top-[112px]"
      >
        <img
          class="w-48 md:w-64 rounded-full outline-6 outline-white"
          transition:name={`img-${slug}`}
          src={img}
          alt={`img-${slug}`}
        />
        <h1 class="relative stroke lg:bottom-11 stroke-current lg:!text-white !text-black !font-bold">
          {title}
        </h1>
      </div>
      <div class="lg:mt-[380px]">
        <Content />
      </div>
    </div>
  </div>
</Layout>

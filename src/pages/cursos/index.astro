---
import Layout from "@layouts/Layout.astro";
import "@styles/components/Cursos.module.css";
import { getCollection, render } from "astro:content";

const courses = await getCollection("courses");
---

<Layout>
  <div class="flex justify-center items-center m-5">
    <div
      class="flex flex-col items-center sm:items-start max-w-4/5 sm:max-w-5xl"
    >
      <div>
        <input
          id="searchInput"
          class="w-full sm:w-[400px] border border-black p-1.5 rounded"
          type="text"
          placeholder="Buscar curso..."
        />
        <button
          id="searchButton"
          class="bg-[#006A07] hover:bg-[#346a35] transition duration-105 text-white px-3 py-2 font-bold"
        >
          Buscar
        </button>
      </div>

      <div id="courseList">
        {
          courses.map((c) => {
            const { data, slug } = c;
            const { title, img, sessionTitles } = data;

            return (
              <a
                href={`/cursos/${slug}`}
                class="!no-underline my-3 flex flex-col sm:flex-row items-center gap-3"
                data-title={title}
              >
                <img
                  transition:name={`img-${slug}`}
                  class="w-full sm:w-64 h-[256px] sm:h-64 object-cover rounded"
                  src={img}
                  alt={`Curso ${slug.replace("-", " ")}`}
                />
                <div class="text-black">
                  <h4 class="!font-bold text-center sm:!text-start underline">
                    {title}
                  </h4>
                  <div class="hidden sm:block">
                    {sessionTitles.map((t) => {
                      return <p class="mb-0">- {t}</p>;
                    })}
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>

  <script>
    // JavaScript para manejar la búsqueda
    const searchInput = document.getElementById("searchInput");
    const courseList = document.getElementById("courseList");
    const searchButton = document.getElementById("searchButton");

    searchButton?.addEventListener("click", () => {
      const searchQuery = searchInput.value.toLowerCase();
      const courses = Array.from(courseList.children);

      courses.forEach((course) => {
        const title = course.getAttribute("data-title")?.toLowerCase();
        if (title?.includes(searchQuery)) {
          course.style.display = "";
        } else {
          course.style.display = "none";
        }
      });
    });

    // También filtrar mientras se escribe en el campo de búsqueda (opcional)
    searchInput?.addEventListener("input", () => {
      const searchQuery = searchInput.value.toLowerCase();
      const courses = Array.from(courseList.children);

      courses.forEach((course) => {
        const title = course.getAttribute("data-title").toLowerCase();
        if (title.includes(searchQuery)) {
          course.style.display = "";
        } else {
          course.style.display = "none";
        }
      });
    });
  </script>
</Layout>

---
import slide1 from "@assets/slides/slide_1.jpg";
import slide2 from "@assets/slides/slide_2.jpg";
import slide3 from "@assets/slides/slide_3.jpg";
import slide4 from "@assets/slides/slide_4.jpg";

const slides = [
  { src: slide1.src, alt: "Quienes somos CPC" },
  { src: slide2.src, alt: "Conocenos CPC" },
  { src: slide3.src, alt: "Quienes somos CPPC" },
  { src: slide4.src, alt: "Conocenos CPPC" },
];
---

<div
  id="carouselExampleIndicators"
  class="carousel carousel-dark slide w-full group relative"
  data-bs-ride="carousel"
>
  <!-- Modern Dark Indicators -->
  <div class="carousel-indicators !-bottom-12 gap-2">
    {slides.map((_, i) => (
      <button
        type="button"
        data-bs-target="#carouselExampleIndicators"
        data-bs-slide-to={i}
        class={i === 0 ? "active !w-8 !h-2 !rounded-full !bg-brand-primary/80 transition-all shadow-[0_0_10px_rgba(16,185,129,0.3)]" : "!w-2 !h-2 !rounded-full !bg-slate-700 hover:!bg-slate-500 transition-all"}
        aria-current={i === 0 ? "true" : "false"}
        aria-label={`Slide ${i + 1}`}
      ></button>
    ))}
  </div>
  
  <div class="carousel-inner rounded-[2rem] overflow-hidden shadow-[0_30px_60px_-15px_rgba(0,0,0,0.7)] border border-white/5 bg-slate-900">
    {slides.map((slide, i) => (
      <div class={`carousel-item ${i === 0 ? 'active' : ''} transition-all duration-1000 ease-in-out`}>
        <div class="relative group/slide overflow-hidden h-[400px] md:h-[550px]">
          <img
            src={slide.src}
            class="d-block w-full h-full object-cover transition-transform duration-10000 ease-linear scale-100 group-[.active]/slide:scale-110 opacity-90"
            alt={slide.alt}
          />
          <!-- Dark Overlay for better image blending -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-black/20 opacity-40 group-hover:opacity-60 transition-opacity duration-700"></div>
          
          <!-- Subtle Glow Overlay -->
          <div class="absolute inset-0 bg-brand-primary/5 opacity-0 group-[.active]/slide:opacity-100 transition-opacity duration-2000 pointer-events-none"></div>
        </div>
      </div>
    ))}
  </div>

  <!-- Controls - Premium Glass style - Dark -->
  <button
    class="carousel-control-prev !left-4 md:!-left-20 opacity-0 group-hover:opacity-100 transition-all duration-500 hover:scale-110 z-30"
    type="button"
    data-bs-target="#carouselExampleIndicators"
    data-bs-slide="prev"
  >
    <div class="w-14 h-14 glass rounded-full flex items-center justify-center text-white border-white/10 hover:border-brand-primary/30 transition-all">
       <i class="fas fa-chevron-left"></i>
    </div>
    <span class="visually-hidden">Anterior</span>
  </button>
  <button
    class="carousel-control-next !right-4 md:!-right-20 opacity-0 group-hover:opacity-100 transition-all duration-500 hover:scale-110 z-30"
    type="button"
    data-bs-target="#carouselExampleIndicators"
    data-bs-slide="next"
  >
    <div class="w-14 h-14 glass rounded-full flex items-center justify-center text-white border-white/10 hover:border-brand-primary/30 transition-all">
       <i class="fas fa-chevron-right"></i>
    </div>
    <span class="visually-hidden">Siguiente</span>
  </button>
</div>

<style>
  /* Dark Mode Carousel Customizations */
  .carousel-indicators [data-bs-target].active {
    background-color: var(--color-brand-primary) !important;
    width: 32px !important;
    opacity: 1;
  }
  
  .carousel-item {
    transition: transform 1.2s cubic-bezier(0.6, 0.05, 0.1, 0.99);
  }
</style>

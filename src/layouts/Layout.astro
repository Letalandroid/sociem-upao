---
import "@styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { title } from "@utils/title";
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Somos dos comités que trabajan juntos para llevar
	  la investigación al siguiente nivel. En esta Gestión 2025,
	  seguimos avanzando juntos hacia descubrimientos. 🫰🏼✨"
    />
    <meta
      name="keywords"
      content="cpc,cppc,piura,sociem,cpc piura,cppc piura,upao,upao piura, cpc piura,cppc piura"
    />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{title}</title>
    <script
      src="https://kit.fontawesome.com/8b1c082df7.js"
      crossorigin="anonymous"></script>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"></script>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    border: none;
    outline: none;
  }
</style>

---
import { title } from "@utils/title";
import VerCursos from "./VerCursos.astro";
---

<div data-aos="flip-left" data-aos-duration="1250" class="w-[320px] sm:w-[400px] md:w-[700px] mx-2 flex flex-col md:flex-row items-center gap-5 bg-white p-10 rounded-[15px]">
  <img
    class="w-[250px] rounded-full"
    src="/logo.png"
    alt="Sociem Upao Piura logo"
  />
  <div class="flex flex-col items-start gap-3 max-w-3xl">
    <div>
      <span class="text-2xl sm:text-4xl text-[#006A07] font-bold">BIENVENIDOS A</span>
      <h1 class="!text-[#006A07] !font-bold !text-2xl sm:!text-4xl">
        {title}
      </h1>
    </div>
    <p class="text-[#006A07] font-bold text-xl">
      💚 ¡CPC-CPPCitos, este es solo el comienzo! 🚀
    </p>
    <VerCursos />
  </div>
</div>

---
import { getCollection, render } from "astro:content";

const courses = await getCollection('courses');
// console.log(courses);

---

<div class="flex justify-center items-center m-2 sm:m-5">
  <div class="flex flex-col items-center sm:items-start max-w-4/5 sm:max-w-5xl">
    <h3
      class="!my-3.5 bg-[#006A07] px-4 py-2 text-white !font-bold rounded-full !text-2xl"
    >
      Últimos Cursos
    </h3>
    {
      courses.map(async (c) => {

        const { Content } = await render(c);
        const { data, slug } = c;
        const { title, img } = data;

        return (
          <div class="my-3 flex flex-col sm:flex-row items-center gap-3">
            <img transition:name={`img-${slug}`} class="w-full sm:w-52 rounded" src={img} alt={`Curso ${slug.replace('-',' ')}`} />
            <a href={`/course/${slug}`} class="text-black !no-underline">
              <h4 class="!font-bold underline">{title}</h4>
              <div class="prose">
                <Content />
              </div>
            </a>
          </div>
        );
      })
    }
  </div>
</div>

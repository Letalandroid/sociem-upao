---
import { title } from "@utils/title";
import VerCursos from "./VerCursos.astro";
---

<div 
  data-aos="fade-up" 
  data-aos-duration="1250" 
  class="relative w-full max-w-4xl mx-auto px-4"
>
  <!-- Decorative background elements - Dark Glow -->
  <div class="absolute -top-12 -left-12 w-64 h-64 bg-brand-primary/10 rounded-full blur-3xl -z-10 animate-pulse"></div>
  <div class="absolute -bottom-12 -right-12 w-64 h-64 bg-brand-secondary/5 rounded-full blur-3xl -z-10 animate-pulse transition-delay-1000"></div>

  <div class="glass p-8 md:p-12 rounded-3xl flex flex-col md:flex-row items-center gap-8 md:gap-12 overflow-hidden relative group border-white/5 border-[1px]">
    <!-- Subtle overlay grid -->
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-[0.03] pointer-events-none"></div>
    
    <!-- Image Section with Ring -->
    <div class="relative">
      <div class="absolute inset-4 bg-brand-primary/30 rounded-full blur-3xl scale-95 group-hover:scale-110 transition-transform duration-700"></div>
      <img
        class="relative w-[180px] md:w-[250px] rounded-full border-4 border-slate-700/50 shadow-2xl transition-transform duration-500 group-hover:scale-105 bg-slate-900"
        src="/logo.png"
        alt="Sociem Upao Piura logo"
      />
    </div>

    <!-- Content Section -->
    <div class="flex flex-col items-center md:items-start text-center md:text-left gap-6 max-w-xl z-10">
      <div class="space-y-1">
        <span class="text-brand-primary font-bold tracking-widest text-sm uppercase opacity-80 block">
          Bienvenidos a la Excelencia
        </span>
        <h1 class="text-4xl md:text-6xl font-extrabold text-white leading-tight font-display tracking-tight drop-shadow-sm">
          {title}
        </h1>
      </div>
      
      <div class="h-1.5 w-20 bg-brand-secondary/80 rounded-full shadow-[0_0_15px_rgba(190,242,100,0.3)]"></div>
      
      <p class="text-slate-400 font-medium text-lg md:text-xl leading-relaxed">
        Investigación que transforma. Descubre un espacio diseñado para potenciar tu crecimiento científico y académico. 
        <span class="block mt-4 text-brand-primary/90 font-bold italic">
          🚀 ¡CPC-CPPCitos, este es solo el comienzo!
        </span>
      </p>
      
      <div class="pt-4">
        <VerCursos />
      </div>
    </div>
  </div>
</div>

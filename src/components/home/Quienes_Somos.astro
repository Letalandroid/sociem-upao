---
import Carousel from "./Carrousel.astro"
---

<section class="relative py-32 overflow-hidden bg-slate-950/40">
    <!-- Background accents - Dark Theme -->
    <div class="absolute inset-0 -z-10 pointer-events-none opacity-20">
        <div class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-brand-primary/10 rounded-full blur-3xl"></div>
        <div class="absolute top-1/4 right-1/4 w-72 h-72 bg-brand-secondary/5 rounded-full blur-3xl transition-delay-500"></div>
    </div>

    <div class="container mx-auto px-6 max-w-6xl">
        <div class="flex flex-col items-center text-center mb-20 space-y-4" data-aos="fade-down" data-aos-duration="1000">
            <span class="inline-block px-4 py-1.5 bg-brand-secondary/10 text-brand-secondary text-xs font-bold uppercase tracking-widest rounded-full border border-brand-secondary/20 shadow-[0_0_10px_rgba(190,242,100,0.1)]">Nuestra Identidad</span>
            
            <div class="relative inline-block">
                <h2 class="text-4xl md:text-5xl font-extrabold text-white relative z-10 font-display">¿Quiénes Somos?</h2>
                <div class="absolute -bottom-2 -right-4 w-full h-4 bg-brand-primary/20 -z-10 skew-x-12 opacity-50 blur-[2px]"></div>
            </div>
            
            <p class="max-w-2xl text-slate-400 text-lg md:text-xl font-medium leading-relaxed mt-8">
                Representamos la excelencia en investigación científica. <span class="text-brand-primary font-bold">CPC</span> y <span class="text-brand-primary font-bold">CPPC</span>, dos comités que trabajan en sinergia para transformar el futuro de la medicina.
            </p>
        </div>

        <div class="relative group" data-aos="zoom-in" data-aos-duration="1200">
            <!-- Carousel wrap with premium card look - Dark -->
            <div class="glass p-4 rounded-[2.5rem] overflow-hidden group-hover:shadow-brand-primary/10 group-hover:shadow-2xl transition-all duration-700 border-white/5">
               <Carousel />
            </div>
            
            <!-- Floating accent card - Dark theme style -->
            <div class="absolute -bottom-10 -left-6 md:-left-12 glass px-8 py-6 rounded-2xl border-l-[6px] border-brand-primary shadow-2xl z-20 animate-bounce transition-duration-3000 hover:animate-none group-hover:scale-105 transition-transform">
                <p class="text-3xl md:text-4xl font-extrabold text-white font-display tracking-tight leading-none mb-0">
                    CPC <span class="text-brand-secondary font-black"> & </span> CPPC
                </p>
                <div class="h-1.5 w-12 bg-brand-secondary/80 mt-3 rounded-full shadow-[0_0_10px_rgba(190,242,100,0.3)]"></div>
            </div>
        </div>
    </div>
</section>